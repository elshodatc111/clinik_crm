# ===== Sotuv (production) uchun xavfsiz sozlamalar — .env ga ko'chiring =====
APP_NAME="Klinika CRM"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://sizning-domen.uz
APP_KEY=            # php artisan key:generate

# Faqat HTTPS: cookie va sessiya himoyasi
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

# Xavfsizlik sarlavhalari: enforce | report | off  (production'da standart: enforce)
SECURITY_CSP=enforce
# Xodimlar ofertani qabul qilishi shart (o'chirmang)
LEGAL_ENFORCE_STAFF_OFFER=true

LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_DATABASE=klinika
DB_USERNAME=klinika_user   # root EMAS, faqat shu bazaga huquqli foydalanuvchi
DB_PASSWORD=               # uzun, tasodifiy parol
